{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/share.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/shared/:token/:slug?",
      "destination": "/api/share?token=:token"
    },
    {
      "source": "/api/share-image/:token",
      "destination": "/api/share-image?token=:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
